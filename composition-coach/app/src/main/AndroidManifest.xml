<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Only needed on Android 9 and below to write to the public Pictures folder; MediaStore handles 10+. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- "Guide by vibration" (Settings > More, off by default): distinct waveforms per direction. A normal
         permission (granted at install, no prompt); without it HapticGuide falls back to view haptics. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      SceneRight never makes a network call — see README.md and docs/PRIVACY_POLICY.md. The
      merged manifest otherwise picks up INTERNET/ACCESS_NETWORK_STATE transitively from ML Kit's
      object-detection artifact (its bundled Firebase/Datatransport telemetry client declares them);
      that telemetry is never invoked by this app, so the permissions are removed from the final
      manifest here rather than left in by accident. `verifyNoInternetPermission`
      (app/build.gradle.kts) fails the build if either ever reappears.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <!-- ACCESS_NETWORK_STATE is deliberately NOT stripped: ML Kit's bundled telemetry queries
         ConnectivityManager and throws SecurityException without it. It is a normal permission (no user
         prompt) and grants no network access by itself; INTERNET above is what actually matters. -->

    <!--
      Nothing leaves the device (docs/PRODUCT.md): no cloud backup and no device-to-device transfer of the
      settings, the taste model (adaptive_weights) or the photo journal (filesDir/journal.jsonl).
      allowBackup/fullBackupContent cover API 30 and below; on 31+ allowBackup no longer stops device
      transfer, so data_extraction_rules.xml excludes every domain from both.
    -->
    <application
        android:name=".CompositionCoachApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CompositionCoach">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.CompositionCoach">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ask Play Services to download ML Kit models at install time so first launch is not blocked. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face" />
    </application>
</manifest>
