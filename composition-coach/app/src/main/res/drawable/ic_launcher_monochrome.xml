<?xml version="1.0" encoding="utf-8"?>
<!--
  Eyebright adaptive icon, monochrome layer for Android 13+ themed icons. Proposed replacement for
  app/src/main/res/drawable/ic_launcher_monochrome.xml (copy as-is; same file name).
  Same ring and catchlight as the foreground, solid white so the system tint reaches every shape.
  Same safe-zone bounds as the foreground (everything inside r = 25 of the 108 dp canvas).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:fillColor="#00000000"
        android:pathData="M32,54 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M41,46 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
</vector>
