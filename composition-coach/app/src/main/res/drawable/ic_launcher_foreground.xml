<?xml version="1.0" encoding="utf-8"?>
<!--
  SceneRight adaptive icon, foreground layer. Proposed replacement for
  app/src/main/res/drawable/ic_launcher_foreground.xml (copy as-is; same file name).

  The mark: an eye seen straight on. A ring (the iris, and the lens), a filled pupil, and one small
  apricot catchlight at the upper right of the pupil (the bright point that makes an eye look alive).
  Drawn as on the brand board's dark card: Paper ring, Paper pupil, Apricot catchlight, over the Ink
  background layer.

  Geometry on the 108 dp canvas (centre 54,54):
    ring       centre (54,54), r = 22, stroke 6   -> outer edge r = 25, inner edge r = 19
    pupil      centre (54,54), r = 12, filled     -> 7 dp clear gap to the ring's inner edge
    catchlight centre (58,50), r = 4,  filled     -> farthest point 9.66 from centre, inside the pupil (12)
  Everything sits inside r = 25, well within the 66 dp safe-zone circle (r = 33), so no launcher
  mask (circle, squircle, teardrop) clips it. At 48 dp (72 dp visible -> x0.667) the ring stroke
  renders ~4 dp, the pupil ~16 dp across and the catchlight ~5.3 dp across: all legible.
  Colours: Paper #F7F3EC and Apricot #E9A17E, from the marketing palette (docs/BRAND.md). No other colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path
        android:strokeColor="#F7F3EC"
        android:strokeWidth="6"
        android:fillColor="#00000000"
        android:pathData="M32,54 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 Z" />
    <path
        android:fillColor="#F7F3EC"
        android:pathData="M42,54 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z" />
    <path
        android:fillColor="#E9A17E"
        android:pathData="M54,50 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
</vector>
